{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://blind-ledger.invalid/schemas/bl_pq512_k128_bus_resource_report_v1.schema.json",
  "title":"Blind Ledger K128 direct-SHA3 derived resource report v1",
  "type":"object",
  "additionalProperties":false,
  "required":["access_rows","activation_allowed","architecture_id","capacity_commitment_512_hex","cbam_commitment_512_hex","chi_and_gate_count","conflict_edges","evidence_class","generated_maximum_padded_width","keccak_round_boundary_bytes","ordered_map_operations","peak_rss_measured","profile_id","qualifies","schedule_commitment_512_hex","schema_version","scratch_measured","segments","sha3_calls","sha3_digest_bytes","sha3_message_plus_digest_bytes","sha3_permutations","sha3_preimage_bytes","state_preimage_bytes","state_sha3_calls","state_sha3_permutations","unmeasured_or_unbounded"],
  "properties":{
    "schema_version":{"const":"blind_ledger_pq512_k128_bus_resource_report_v1"},
    "evidence_class":{"const":"DERIVED_MODEL"},
    "architecture_id":{"const":"RETIRED_DIRECT_SHA3_STARK_V1"},
    "profile_id":{"const":"K128_CALIBRATION"},
    "schedule_commitment_512_hex":{"$ref":"#/$defs/digest"},
    "capacity_commitment_512_hex":{"$ref":"#/$defs/digest"},
    "cbam_commitment_512_hex":{"$ref":"#/$defs/digest"},
    "segments":{"type":"array","minItems":6,"maxItems":6,"items":{"$ref":"#/$defs/segment"}},
    "sha3_calls":{"const":46858},
    "sha3_permutations":{"const":113730},
    "sha3_preimage_bytes":{"const":7996042},
    "sha3_digest_bytes":{"const":2998912},
    "sha3_message_plus_digest_bytes":{"const":10994954},
    "keccak_round_boundary_bytes":{"const":568650000},
    "chi_and_gate_count":{"const":4367232000},
    "state_sha3_calls":{"const":46208},
    "state_sha3_permutations":{"const":96900},
    "state_preimage_bytes":{"const":6800980},
    "ordered_map_operations":{"const":641},
    "access_rows":{"const":1282},
    "conflict_edges":{"const":764},
    "peak_rss_measured":{"const":false},
    "scratch_measured":{"const":false},
    "qualifies":{"const":false},
    "activation_allowed":{"const":false},
    "generated_maximum_padded_width":{"type":"null"},
    "unmeasured_or_unbounded":{"const":["generated_backend_width","generated_backend_commitment_layout","generated_backend_peak_rss","generated_backend_scratch","allocator_overhead","cross_term_cost","promoted_tail_cost","measured_latency","measured_io"]}
  },
  "$defs":{
    "digest":{"type":"string","pattern":"^[0-9a-f]{128}$"},
    "segment":{"type":"object","additionalProperties":false,"required":["component","tag","call_offset","call_count"],"properties":{"component":{"enum":["claim_truth","a12_nullifier","salt_use","replay_map","payment","master"]},"tag":{"type":"integer","minimum":1,"maximum":6},"call_offset":{"type":"integer","minimum":0},"call_count":{"type":"integer","minimum":1}}}
  }
}
