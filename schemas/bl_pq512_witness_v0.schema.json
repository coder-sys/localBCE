            {
              "properties": {
                "index": {
                  "const": 9
                },
                "name": {
                  "const": "opaqueBatchCommitment"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/public_field_item"
            },
            {
              "properties": {
                "index": {
                  "const": 10
                },
                "name": {
                  "const": "valueConservationCommitment"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/public_field_item"
            },
            {
              "properties": {
                "index": {
                  "const": 11
                },
                "name": {
                  "const": "settlementCommitment"
                }
              }
            }
          ]
        }
      ],
      "items": false
    },
    "diagnosis_slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "diagnosis_slot",
        "diagnosis_code"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "diagnosis_slot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "diagnosis_code": {
          "type": "string",
          "maxLength": 16,
          "pattern": "^[A-Z0-9.]*$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "diagnosis_code": {
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "diagnosis_code": {
                "const": ""
              }
            }
          }
        }
      ]
    },
    "fact_slot_base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_slot",
