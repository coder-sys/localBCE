      }
    },
    "policy_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_present",
        "row_kind",
        "procedure_code",
        "allowed_cents",
        "requires_prior_authorization",
        "policy_leaf_index",
        "next_procedure_code",
        "next_policy_leaf_index",
        "legacy_path",
        "wide_path"
      ],
      "properties": {
        "policy_present": {
          "type": "boolean"
        },
        "row_kind": {
          "enum": [
            0,
            1,
            2
          ]
        },
        "procedure_code": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^[A-Z0-9]*$"
        },
        "allowed_cents": {
          "$ref": "#/$defs/private_cents"
