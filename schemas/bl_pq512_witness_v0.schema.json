            },
            {
              "properties": {
                "index": {
                  "const": 4
                },
                "name": {
                  "const": "nullifierRootAfter"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/public_field_item"
            },
            {
              "properties": {
                "index": {
                  "const": 5
                },
                "name": {
                  "const": "claimSourceRoot"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/public_field_item"
            },
