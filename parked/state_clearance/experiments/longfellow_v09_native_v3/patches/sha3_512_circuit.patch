diff --git a/lib/circuits/tests/sha3/sha3_circuit.h b/lib/circuits/tests/sha3/sha3_circuit.h
--- a/lib/circuits/tests/sha3/sha3_circuit.h
+++ b/lib/circuits/tests/sha3/sha3_circuit.h
@@ -322,2 +322,117 @@
     check(bw_idx == bws.size(), "Did not consume all BlockWitnesses");
   }
+  // Computes the fixed FIPS 202 SHA3-512 hash of seed in-circuit.
+  //
+  // The circuit has no caller-selected rate, suffix, output length, or
+  // squeeze count: SHA3-512 is rate 72, capacity 1024, uses 0x06 and 0x80,
+  // and emits 64 bytes. Hidden seed bytes and selected Keccak witnesses are
+  // constrained by this circuit.
+  void assert_sha3_512(const std::vector<v8>& seed, std::vector<v8>& out,
+                       const std::vector<BlockWitness>& bws) {
+    constexpr size_t kRate = 72;
+    constexpr size_t kDigestSize = 64;
+    const size_t num_absorb_blocks = (seed.size() + kRate) / kRate;
+    check(bws.size() == num_absorb_blocks,
+          "Incorrect number of SHA3-512 BlockWitnesses");
+    out.resize(kDigestSize);
+    std::vector<v8> block(200);
+    for (size_t i = 0; i < block.size(); ++i) {
+      block[i] = lc_.template vbit<8>(0);
+    }
+    size_t bw_idx = 0;
+    size_t ptr = 0;
+    for (size_t i = 0; i < seed.size(); ++i) {
+      block[ptr++] = seed[i];
+      if (ptr == kRate) {
+        v64 A_in[5][5];
+        for (size_t x = 0; x < 5; ++x) {
+          for (size_t y = 0; y < 5; ++y) {
+            if (bw_idx == 0) {
+              A_in[x][y] = lc_.template vbit<64>(0);
+            } else {
+              A_in[x][y] = bws[bw_idx - 1].a_intermediate[23][x][y];
+            }
+          }
+        }
+        xorin_block(A_in, block, kRate);
+        keccak_f_1600(A_in, bws[bw_idx++]);
+        ptr = 0;
+        for (size_t j = 0; j < block.size(); ++j) {
+          block[j] = lc_.template vbit<8>(0);
+        }
+      }
+    }
+    block[ptr] = lc_.template vbit<8>(0x06);
+    block[kRate - 1] =
+        lc_.vxor(block[kRate - 1], lc_.template vbit<8>(0x80));
+    v64 A_in[5][5];
+    for (size_t x = 0; x < 5; ++x) {
+      for (size_t y = 0; y < 5; ++y) {
+        if (bw_idx == 0) {
+          A_in[x][y] = lc_.template vbit<64>(0);
+        } else {
+          A_in[x][y] = bws[bw_idx - 1].a_intermediate[23][x][y];
+        }
+      }
+    }
+    xorin_block(A_in, block, kRate);
+    keccak_f_1600(A_in, bws[bw_idx++]);
+    const BlockWitness& final_bw = bws[bw_idx - 1];
+    for (size_t i = 0; i < kDigestSize; ++i) {
+      const size_t lane = i / 8;
+      const size_t byte = i % 8;
+      const size_t x = lane % 5;
+      const size_t y = lane / 5;
+      for (size_t bit = 0; bit < 8; ++bit) {
+        out[i][bit] =
+            final_bw.a_intermediate[23][x][y][byte * 8 + bit];
+      }
+    }
+    check(bw_idx == bws.size(), "Did not consume all SHA3-512 witnesses");
+  }
+
+  // Same fixed SHA3-512 relation without checkpoint witnesses. This keeps
+  // the complete Keccak-f[1600] computation in the circuit and is used only
+  // to measure the construction tradeoff against sliced checkpoints.
+  void assert_sha3_512_no_witness(const std::vector<v8>& seed,
+                                  std::vector<v8>& out) {
+    constexpr size_t kRate = 72;
+    constexpr size_t kDigestSize = 64;
+    out.resize(kDigestSize);
+    std::vector<v8> block(200);
+    for (size_t i = 0; i < block.size(); ++i) {
+      block[i] = lc_.template vbit<8>(0);
+    }
+    v64 A_in[5][5];
+    for (size_t x = 0; x < 5; ++x) {
+      for (size_t y = 0; y < 5; ++y) {
+        A_in[x][y] = lc_.template vbit<64>(0);
+      }
+    }
+    size_t ptr = 0;
+    for (const auto& byte : seed) {
+      block[ptr++] = byte;
+      if (ptr == kRate) {
+        xorin_block(A_in, block, kRate);
+        keccak_f_1600(A_in);
+        ptr = 0;
+        for (size_t j = 0; j < block.size(); ++j) {
+          block[j] = lc_.template vbit<8>(0);
+        }
+      }
+    }
+    block[ptr] = lc_.template vbit<8>(0x06);
+    block[kRate - 1] =
+        lc_.vxor(block[kRate - 1], lc_.template vbit<8>(0x80));
+    xorin_block(A_in, block, kRate);
+    keccak_f_1600(A_in);
+    for (size_t i = 0; i < kDigestSize; ++i) {
+      const size_t lane = i / 8;
+      const size_t byte = i % 8;
+      const size_t x = lane % 5;
+      const size_t y = lane / 5;
+      for (size_t bit = 0; bit < 8; ++bit) {
+        out[i][bit] = A_in[x][y][byte * 8 + bit];
+      }
+    }
+  }
