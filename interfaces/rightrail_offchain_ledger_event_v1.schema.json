{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localbce.invalid/schemas/rightrail_offchain_ledger_event_v1.schema.json",
  "title": "localBCE RightRail off-chain ledger event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sequence",
    "event_id",
    "event_type",
    "aggregate_id",
    "idempotency_key",
    "recorded_at",
    "payload",
    "payload_sha256",
    "previous_event_sha256",
    "event_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "localbce-rightrail-offchain-ledger-event-v1"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "event_id": {
      "type": "string",
      "pattern": "^rrevt-[0-9a-f]{32}$"
    },
    "event_type": {
      "enum": [
        "ADJUDICATION_RECORDED",
        "REMITTANCE_RECORDED"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "previous_event_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "event_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
