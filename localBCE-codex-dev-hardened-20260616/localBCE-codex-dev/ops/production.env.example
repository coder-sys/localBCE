BL_ORACLE_IN_CIRCUIT_KEY_ROOT=REPLACE_WITH_64_HEX_ROOT
BL_SETTLEMENT_ADDRESS_BOOK_ROOT=REPLACE_WITH_64_HEX_ROOT
