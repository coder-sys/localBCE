# Blind Ledger production environment template.
# Replace every REPLACE_* value before production. The validator rejects placeholders.

BL_ENV=production
BL_PROOF_LANE=CAIRO_STARK_NATIVE
BL_FIELD_STRATEGY=STARK_FIELD_END_TO_END
BL_HASH_STRATEGY=POSEIDON_STARK_FIELD_DOMAIN_SEPARATED
BL_ONCHAIN_PROOF_ANCHOR=NATIVE_STARK_DIRECT_ANCHOR

BL_BINDING_CIRCUIT_AUDITED_SHA256=REPLACE_WITH_64_HEX_SHA256
BL_BATCH_BINDING_VERIFIER_KEY_SHA256=REPLACE_WITH_64_HEX_SHA256
BL_RAW_837_DERIVATION_CIRCUIT_SHA256=REPLACE_WITH_64_HEX_SHA256
BL_NULLIFIER_TRANSITION_CIRCUIT_SHA256=REPLACE_WITH_64_HEX_SHA256
BL_PAYMENT_RECONCILIATION_CIRCUIT_SHA256=REPLACE_WITH_64_HEX_SHA256
BL_BATCH_AGGREGATOR_CIRCUIT_SHA256=REPLACE_WITH_64_HEX_SHA256
BL_VALUE_CONSERVATION_CIRCUIT_SHA256=REPLACE_WITH_64_HEX_SHA256
BL_AGGREGATION_VALUE_CONSERVATION_ROOT=REPLACE_WITH_64_HEX_ROOT
BL_RULE_CROSSWALK_HASH=REPLACE_WITH_64_HEX_SHA256
BL_LANE_DECISION_V2_SIGNED_SHA256=REPLACE_WITH_64_HEX_SHA256
BL_RULE_RATIFICATION_PUBLIC_KEYS_ROOT=REPLACE_WITH_64_HEX_ROOT
BL_NATIVE_STARK_VERIFIER_ADDRESS=REPLACE_WITH_0X_EVM_ADDRESS
BL_NATIVE_STARK_VERIFIER_ARTIFACT_SHA256=REPLACE_WITH_64_HEX_SHA256
BL_ACCUMULATOR_ROOT=REPLACE_WITH_64_HEX_ROOT
BL_AUDIT_DATA_ENCRYPTION_KEY_ROOT=REPLACE_WITH_64_HEX_ROOT
BL_NULLIFIER_NAMESPACE_ROOT=REPLACE_WITH_64_HEX_ROOT
BL_EFFECTIVE_RULESET_TIMELINE_ROOT=REPLACE_WITH_64_HEX_ROOT
BL_FEE_SCHEDULE_ROOT=REPLACE_WITH_64_HEX_ROOT
BL_ELIGIBILITY_ORACLE_ROOT=REPLACE_WITH_64_HEX_ROOT
BL_PROVIDER_STATUS_ORACLE_ROOT=REPLACE_WITH_64_HEX_ROOT
