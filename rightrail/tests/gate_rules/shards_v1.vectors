# Synthetic IDs, no PHI.  Header (snapshots) copied from rules_v1.vectors.

# Decide layer (decide-layer-v1 section 3).  `commit SHOW` prints RULES_DIGEST (the state digest after it) and
# RULES_ADDS (the rows it appended: u8 set, 1 released or 2 unresolved, then the 923-byte Line.fields row).
# `load G_ASOF ADDS ANCHOR` replays stored rows onto empty sets and refuses unless they hash to ANCHOR.
# Same-shard resend: a line that shard 0 already released (701) or left unresolved (703) holds as ALREADY_DECIDED.
# Two batches decided continuously ...
case decide_continuous
line 701 FFS_CLAIM 1001 7001 7001 20270305 99213 1 12500 ALLOW -
line 702 FFS_CLAIM 1002 7001 7001 20270306 99213 1 11000 ALLOW -
line 703 FFS_CLAIM 9001 7001 7001 20270305 99213 1 12500 HOLD MEMBER_DECEASED
commit SHOW
line 701 FFS_CLAIM 1001 7001 7001 20270305 99213 1 12500 HOLD ALREADY_DECIDED,FFS_DUPLICATE_LINE with=701
line 703 FFS_CLAIM 9001 7001 7001 20270305 99213 1 12500 HOLD ALREADY_DECIDED,DUPLICATE_OF_UNRESOLVED,MEMBER_DECEASED with=703
line 704 FFS_CLAIM 1005 7001 7001 20270307 99213 1 9000 ALLOW -
commit SHOW

# ... equal the first batch's stored rows loaded after a restart, then the second batch (identical lines).
case decide_reloaded
load 20270315  270270b766fbc9a4a1024e35c7fc5772f4732c57950bd8553196bb4ff3c4bf125a7067290f7a351e88fdaddc1d1d7a6881c7befdf55504516f7acbabc854fa79
line 701 FFS_CLAIM 1001 7001 7001 20270305 99213 1 12500 HOLD ALREADY_DECIDED,FFS_DUPLICATE_LINE with=701
line 703 FFS_CLAIM 9001 7001 7001 20270305 99213 1 12500 HOLD ALREADY_DECIDED,DUPLICATE_OF_UNRESOLVED,MEMBER_DECEASED with=703
line 704 FFS_CLAIM 1005 7001 7001 20270307 99213 1 9000 ALLOW -
commit SHOW

# The v1 digest sorts rows, so adds reordered within a set still load and decide the same (the order gap, section 3.3).
case decide_reordered
load 20270315  270270b766fbc9a4a1024e35c7fc5772f4732c57950bd8553196bb4ff3c4bf125a7067290f7a351e88fdaddc1d1d7a6881c7befdf55504516f7acbabc854fa79
line 701 FFS_CLAIM 1001 7001 7001 20270305 99213 1 12500 HOLD ALREADY_DECIDED,FFS_DUPLICATE_LINE with=701
line 703 FFS_CLAIM 9001 7001 7001 20270305 99213 1 12500 HOLD ALREADY_DECIDED,DUPLICATE_OF_UNRESOLVED,MEMBER_DECEASED with=703
line 704 FFS_CLAIM 1005 7001 7001 20270307 99213 1 9000 ALLOW -
commit SHOW

