theorem squeezeK_eq (s : Quick.St) (k : Nat) (hk : k ≤ 168) : Quick.squeezeK s k = bytesOf s.toFast k := by
  rw [squeezeK_eq_SQ]
  apply Good.eq_bytesOf
  exact SQ0_good s k hk _ (zeros_extract_size k hk) (fun j hj => by omega) (by omega)

theorem bytesOf_zero (s : Fast.St) : bytesOf s 0 = ByteArray.empty := rfl

theorem bytesOf_succ (s : Fast.St) (k : Nat) : bytesOf s (k + 1) = (bytesOf s k).push (gb s k) := by
  apply ByteArray.ext
  simp [bytesOf, List.range'_concat, ByteArray.data_push]

theorem append_push (o x : ByteArray) (b : UInt8) : o ++ x.push b = (o ++ x).push b := by
  apply ByteArray.ext
  simp [ByteArray.data_append, ByteArray.data_push]

theorem sqF_block (st : Fast.St) (n : Nat) (o : ByteArray) (r : Nat) :
    List.foldl (fun b a => if b.size < n then b.push (Fast.lane st (a / 8) >>> UInt64.ofNat (8 * (a % 8))).toUInt8 else b) o
      (List.range' 0 r) = o ++ bytesOf st (min r (n - o.size)) := by
  induction r with
  | zero => simp [bytesOf_zero, ByteArray.append_empty]
  | succ r ih =>
    rw [List.range'_concat, List.foldl_append, ih]
    simp only [List.foldl_cons, List.foldl_nil, Nat.zero_add, Nat.one_mul, ByteArray.size_append, bytesOf_size]
    by_cases h : o.size + min r (n - o.size) < n
    · rw [if_pos h]
      have : min (r + 1) (n - o.size) = min r (n - o.size) + 1 := by omega
      rw [this, bytesOf_succ, append_push]
      have : min r (n - o.size) = r := by omega
      rw [this]; rfl
    · rw [if_neg h]
      have : min (r + 1) (n - o.size) = min r (n - o.size) := by omega
      rw [this]

def emit (rate n : Nat) (st : Fast.St) (o : ByteArray) : ByteArray := o ++ bytesOf st (min rate (n - o.size))

def emitLoop (rate n : Nat) : Nat → Fast.St → ByteArray → ByteArray
  | 0, _, o => o
  | c + 1, st, o => emitLoop rate n c (Fast.keccakF st) (emit rate n st o)

def stepF (rate n : Nat) (b : Fast.St × ByteArray) (a : Nat) : Fast.St × ByteArray :=
  if a > 0 then (Fast.keccakF b.1, emit rate n (Fast.keccakF b.1) b.2) else (b.1, emit rate n b.1 b.2)

theorem foldF_pos (rate n c : Nat) : ∀ (a0 : Nat), 0 < a0 → ∀ (st : Fast.St) (o : ByteArray),
    ((List.range' a0 c).foldl (stepF rate n) (st, o)).2 = emitLoop rate n c (Fast.keccakF st) o := by
  induction c with
  | zero => intro a0 _ st o; rfl
  | succ c ih =>
    intro a0 ha st o
    rw [List.range'_succ, List.foldl_cons]
    have : stepF rate n (st, o) a0 = (Fast.keccakF st, emit rate n (Fast.keccakF st) o) := by
      simp [stepF, ha]
    rw [this, ih (a0 + 1) (by omega)]
    rfl

theorem foldF_all (rate n K : Nat) (st : Fast.St) :
    ((List.range' 0 K).foldl (stepF rate n) (st, ByteArray.empty)).2 = emitLoop rate n K st ByteArray.empty := by
  cases K with
  | zero => rfl
  | succ c =>
    rw [List.range'_succ, List.foldl_cons]
    have : stepF rate n (st, ByteArray.empty) 0 = (st, emit rate n st ByteArray.empty) := by simp [stepF]
    rw [this, foldF_pos rate n c 1 (by omega)]
    rfl

theorem go_eq (rate : Nat) (h0 : 0 < rate) (h1 : rate ≤ 168) (n : Nat) : ∀ (fuel : Nat) (sQ : Quick.St) (out : ByteArray) (left : Nat),
    out.size + left = n → (left + rate - 1) / rate ≤ fuel →
    Quick.sponge.go rate fuel sQ out left = emitLoop rate n ((left + rate - 1) / rate) sQ.toFast out := by
  intro fuel
  induction fuel with
  | zero =>
    intro sQ out left hn hf
    have : left = 0 := by
      by_cases hne : left = 0
      · exact hne
      · exfalso
        have : 1 ≤ (left + rate - 1) / rate := by
          apply (Nat.le_div_iff_mul_le h0).2; omega
        omega
    subst this
    have : (0 + rate - 1) / rate = 0 := Nat.div_eq_of_lt (by omega)
    rw [this]
    simp [Quick.sponge.go, emitLoop]
  | succ f ih =>
    intro sQ out left hn hf
    have hk : (if left < rate then left else rate) ≤ 168 := by split <;> omega
    have key : ∀ k, k ≤ 168 → (if out.size = 0 then Quick.squeezeK sQ k else out ++ Quick.squeezeK sQ k) = out ++ bytesOf sQ.toFast k := by
      intro k hk
      rw [squeezeK_eq sQ k hk]
      split
      · rename_i h
        rw [ByteArray.size_eq_zero_iff.1 h, ByteArray.empty_append]
      · rfl
    unfold Quick.sponge.go
    simp only [key _ hk]
    by_cases hl : left ≤ rate
    · rw [if_pos hl]
      by_cases hz : left = 0
      · subst hz
        have : (0 + rate - 1) / rate = 0 := Nat.div_eq_of_lt (by omega)
        rw [this, if_pos h0]
        simp [bytesOf_zero, ByteArray.append_empty, emitLoop]
      · have : (left + rate - 1) / rate = 1 := by
          apply Nat.div_eq_of_lt_le <;> omega
        rw [this]
        simp only [emitLoop, emit]
        have e1 : (if left < rate then left else rate) = min rate (n - out.size) := by split <;> omega
        rw [e1]
    · rw [if_neg hl]
      have e2 : (left + rate - 1) / rate = (left - rate + rate - 1) / rate + 1 := by
        have : left + rate - 1 = (left - rate + rate - 1) + rate := by omega
        rw [this, Nat.add_div_right _ h0]
      rw [e2]
      simp only [emitLoop, emit]
      have e1 : (if left < rate then left else rate) = min rate (n - out.size) := by split <;> omega
      have e3 : (if left < rate then left else rate) = rate := by rw [if_neg (by omega)]
      rw [e3] at e1 ⊢
      rw [ih (Quick.keccakF sQ) (out ++ bytesOf sQ.toFast rate) (left - rate)
        (by rw [ByteArray.size_append, bytesOf_size]; omega) (by omega)]
      rw [keccakF_eq' sQ, ← e1]


theorem lane_m (i nl lim : Nat) (a m l1 l2 : UInt64)
    (h : i < nl → if (i ≤ lim || i + 1 == nl) = true then l1 = l2 else l2 = 0) :
    ((if i < nl && (i ≤ lim || i + 1 == nl) then a ^^^ l1 else a) ^^^ m) = if i < nl then (a ^^^ m) ^^^ l2 else a ^^^ m := by
  by_cases hi : i < nl
  · have h' := h hi
    by_cases hc : (i ≤ lim || i + 1 == nl) = true
    · rw [if_pos hc] at h'
      simp only [hi, hc, h', decide_true, Bool.true_and, if_true]
      qbits
    · rw [if_neg hc] at h'
      simp only [hi, hc, h', decide_true, Bool.true_and, if_true]
      simp [hc]
  · simp [hi]

theorem lane_0 (i nl lim : Nat) (a l1 l2 : UInt64)
    (h : i < nl → if (i ≤ lim || i + 1 == nl) = true then l1 = l2 else l2 = 0) :
    (if i < nl && (i ≤ lim || i + 1 == nl) then a ^^^ l1 else a) = if i < nl then a ^^^ l2 else a := by
  by_cases hi : i < nl
  · have h' := h hi
    by_cases hc : (i ≤ lim || i + 1 == nl) = true
    · rw [if_pos hc] at h'
      simp only [hi, hc, h', decide_true, Bool.true_and, if_true]
    · rw [if_neg hc] at h'
      simp only [hi, hc, h', decide_true, Bool.true_and, if_true]
      simp [hc]
  · simp [hi]

theorem perm_toFast (a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 a17 a18 a19 a20 a21 a22 a23 a24 : UInt64) :
    (Quick.perm Quick.permSteps a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 a17 a18 a19 a20 a21 a22 a23 a24).toFast =
      Fast.keccakF (Quick.St.toFast ⟨a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24⟩) :=
  keccakF_eq' ⟨a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24⟩

theorem absorbF_eq (s : Quick.St) (d : ByteArray) (f : Nat → UInt8) (oQ oF nl lim : Nat)
    (h : ∀ i, i < nl → if (i ≤ lim || i + 1 == nl) = true then Quick.ld d (oQ + 8 * i) = Fast.loadF f (oF + 8 * i)
      else Fast.loadF f (oF + 8 * i) = 0) :
    (Quick.absorbF s d oQ nl lim).toFast = Fast.keccakF (Fast.absorb s.toFast f oF nl) := by
  have h' : ∀ i, i < nl → if (i ≤ lim || i + 1 == nl) = true then Quick.ld d (oQ + 8 * i) = Fast.loadF f (oF + 8 * i)
      else Fast.loadF f (oF + 8 * i) = 0 := h
  unfold Quick.absorbF
  rw [perm_toFast]
  congr 1
  simp only [Quick.St.toFast, Fast.absorb, Fast.St.mk.injEq]
  refine ⟨lane_0 _ _ _ _ _ _ (h' 0), lane_m _ _ _ _ _ _ _ (h' 1), lane_m _ _ _ _ _ _ _ (h' 2), lane_0 _ _ _ _ _ _ (h' 3), lane_0 _ _ _ _ _ _ (h' 4), lane_0 _ _ _ _ _ _ (h' 5), lane_0 _ _ _ _ _ _ (h' 6), lane_0 _ _ _ _ _ _ (h' 7), lane_m _ _ _ _ _ _ _ (h' 8), lane_0 _ _ _ _ _ _ (h' 9), lane_0 _ _ _ _ _ _ (h' 10), lane_0 _ _ _ _ _ _ (h' 11), lane_m _ _ _ _ _ _ _ (h' 12), lane_0 _ _ _ _ _ _ (h' 13), lane_0 _ _ _ _ _ _ (h' 14), lane_0 _ _ _ _ _ _ (h' 15), lane_0 _ _ _ _ _ _ (h' 16), lane_m _ _ _ _ _ _ _ (h' 17), lane_0 _ _ _ _ _ _ (h' 18), lane_0 _ _ _ _ _ _ (h' 19), lane_m _ _ _ _ _ _ _ (h' 20), lane_0 _ _ _ _ _ _ (h' 21), lane_0 _ _ _ _ _ _ (h' 22), lane_0 _ _ _ _ _ _ (h' 23), lane_0 _ _ _ _ _ _ (h' 24)⟩

theorem get!_eq' (b : ByteArray) (i : Nat) (h : i < b.size) : b.get! i = b[i]'h := by
  cases b with
  | mk bs =>
    simp only [ByteArray.get!, ByteArray.getElem_eq_getElem_data]
    exact getElem!_pos bs i h

theorem ld_eq (d : ByteArray) (o : Nat) (h : o + 7 < d.size) : Quick.ld d o = Fast.loadF (d.get! ·) o := by
  unfold Quick.ld Fast.loadF
  rw [dif_pos h]
  dsimp only
  rw [get!_eq' d o (by omega), get!_eq' d (o+1) (by omega), get!_eq' d (o+2) (by omega), get!_eq' d (o+3) (by omega),
    get!_eq' d (o+4) (by omega), get!_eq' d (o+5) (by omega), get!_eq' d (o+6) (by omega), get!_eq' d (o+7) (by omega)]

theorem flipped_eq : Quick.flipped.toFast = Fast.zero := by rfl

theorem loadF_congr (f g : Nat → UInt8) (o o' : Nat) (h : ∀ j, j < 8 → f (o + j) = g (o' + j)) :
    Fast.loadF f o = Fast.loadF g o' := by
  have h0 : f o = g o' := by simpa using h 0 (by omega)
  have h1 := h 1 (by omega)
  have h2 := h 2 (by omega)
  have h3 := h 3 (by omega)
  have h4 := h 4 (by omega)
  have h5 := h 5 (by omega)
  have h6 := h 6 (by omega)
  have h7 := h 7 (by omega)
  unfold Fast.loadF
  rw [h0, h1, h2, h3, h4, h5, h6, h7]

theorem loadF_zero (f : Nat → UInt8) (o : Nat) (h : ∀ j, j < 8 → f (o + j) = 0) : Fast.loadF f o = 0 := by
  have h0 : f o = 0 := by simpa using h 0 (by omega)
  have h1 := h 1 (by omega)
  have h2 := h 2 (by omega)
  have h3 := h 3 (by omega)
  have h4 := h 4 (by omega)
  have h5 := h 5 (by omega)
  have h6 := h 6 (by omega)
  have h7 := h 7 (by omega)
  unfold Fast.loadF
  rw [h0, h1, h2, h3, h4, h5, h6, h7]
  decide

theorem zeros_size' : Quick.zeros.size = 168 := by simp [Quick.zeros, ByteArray.size]

theorem zeros_get (k : Nat) : (Quick.zeros[k]! : UInt8) = 0 := by
  by_cases hk : k < Quick.zeros.size
  · rw [getElem!_pos _ k hk, ByteArray.getElem_eq_getElem_data]; simp [Quick.zeros]
  · rw [getElem!_neg _ k hk]; rfl

theorem C_size (Z data : ByteArray) (s rem : Nat) (hZ : Z.size = 168) (hs : s + rem = data.size) (hr : rem ≤ 168) :
    (data.copySlice s Z 0 rem).size = 168 := by
  rw [ByteArray.copySlice_eq_append]
  simp [ByteArray.size_extract, hZ]
  omega

theorem C_get (Z data : ByteArray) (s rem : Nat) (hZ : Z.size = 168) (hZ0 : ∀ k : Nat, (Z[k]! : UInt8) = 0) (hs : s + rem = data.size) (hr : rem ≤ 168) (j : Nat) (hj : j < 168) :
    (data.copySlice s Z 0 rem)[j]! = if j < rem then data[s + j]! else 0 := by
  rw [ByteArray.copySlice_eq_append]
  have hmin : 0 + min rem (data.data.size - s) = rem := by
    have : data.data.size = data.size := rfl
    omega
  rw [hmin]
  have hA : (Z.extract 0 0 ++ data.extract s (s + rem)).size = rem := by
    simp [ByteArray.size_extract, hZ]; omega
  have hC : (Z.extract rem Z.data.size).size = 168 - rem := by simp [ByteArray.size_extract, hZ]
  have hbig : j < (Z.extract 0 0 ++ data.extract s (s + rem) ++ Z.extract rem Z.data.size).size := by
    rw [ByteArray.size_append, hA, hC]; omega
  rw [getElem!_pos _ j hbig]
  by_cases h : j < rem
  · rw [if_pos h, ByteArray.getElem_append_left (by omega)]
    rw [ByteArray.getElem_append_right (by simp [ByteArray.size_extract])]
    rw [ByteArray.getElem_extract, getElem!_pos]
    · simp
    · omega
  · rw [if_neg h, ByteArray.getElem_append_right (by omega)]
    have h1 : j - (Z.extract 0 0 ++ data.extract s (s + rem)).size < (Z.extract rem Z.data.size).size := by omega
    rw [ByteArray.getElem_extract, ← getElem!_pos Z _ (by omega)]
    exact hZ0 _

theorem get!_gen (b : ByteArray) (i : Nat) : b.get! i = b[i]! := by
  cases b; first | rfl | (simp [ByteArray.get!, getElem!_def]; rfl)

theorem tail_get (suffix : UInt8) (data : ByteArray) (rate full rem : Nat) (h168 : rate ≤ 168) (hpos : 0 < rate)
    (hs : full * rate + rem = data.size) (hrem : rem < rate) (j : Nat) (hj : j < rate) :
    (((data.copySlice (full * rate) Quick.zeros 0 rem).set! rem suffix).set! (rate - 1)
      (((data.copySlice (full * rate) Quick.zeros 0 rem).set! rem suffix).get! (rate - 1) ||| 0x80)).get! j
      = Fast.padByte data suffix ((full + 1) * rate) (full * rate + j) := by
  have hC := C_size Quick.zeros data (full * rate) rem zeros_size' hs (by omega)
  have hsz : ((data.copySlice (full * rate) Quick.zeros 0 rem).set! rem suffix).size = 168 := by
    rw [ByteArray.size_set!]; exact hC
  have e1 := fun k (hk : k < 168) => C_get Quick.zeros data (full * rate) rem zeros_size' zeros_get hs (by omega) k hk
  simp only [get!_gen, Fast.padByte]
  rw [ByteArray.getElem!_set! _ _ _ _ (by omega)]
  rw [ByteArray.getElem!_set! _ _ _ _ (by omega)]
  rw [ByteArray.getElem!_set! _ _ _ _ (by omega)]
  rw [e1 (rate - 1) (by omega), e1 j (by omega)]
  have : (full + 1) * rate = full * rate + rate := Nat.succ_mul ..
  rw [this]
  repeat' split
  all_goals first | rfl | (exfalso; omega) | simp

def tailB (suffix : UInt8) (data : ByteArray) (rate full rem : Nat) : ByteArray :=
  (((data.copySlice (full * rate) Quick.zeros 0 rem).set! rem suffix).set! (rate - 1)
      (((data.copySlice (full * rate) Quick.zeros 0 rem).set! rem suffix).get! (rate - 1) ||| 0x80))

theorem tailB_size (suffix : UInt8) (data : ByteArray) (rate full rem : Nat) (hs : full * rate + rem = data.size) (hrem : rem < rate)
    (h168 : rate ≤ 168) : (tailB suffix data rate full rem).size = 168 := by
  unfold tailB
  rw [ByteArray.size_set!, ByteArray.size_set!]
  exact C_size Quick.zeros data (full * rate) rem zeros_size' hs (by omega)

theorem tail_ok (suffix : UInt8) (data : ByteArray) (rate full rem : Nat) (hr : rate = 72 ∨ rate = 136 ∨ rate = 168)
    (hs : full * rate + rem = data.size) (hrem : rem < rate) (i : Nat) (hi : i < rate / 8) :
    if (i ≤ rem / 8 || i + 1 == rate / 8) = true then
      Quick.ld (tailB suffix data rate full rem) (0 + 8 * i) = Fast.loadF (Fast.padByte data suffix ((full + 1) * rate)) (full * rate + 8 * i)
    else Fast.loadF (Fast.padByte data suffix ((full + 1) * rate)) (full * rate + 8 * i) = 0 := by
  have hsz := tailB_size suffix data rate full rem hs hrem (by omega)
  have e : (full + 1) * rate = full * rate + rate := Nat.succ_mul ..
  by_cases hc : (i ≤ rem / 8 || i + 1 == rate / 8) = true
  · rw [if_pos hc, ld_eq _ _ (by omega)]
    apply loadF_congr
    intro k hk
    have := tail_get suffix data rate full rem (by omega) (by omega) hs hrem (0 + 8 * i + k) (by omega)
    have e2 : full * rate + (0 + 8 * i + k) = full * rate + 8 * i + k := by omega
    rw [e2] at this
    exact this
  · rw [if_neg hc]
    simp only [Bool.or_eq_true, decide_eq_true_eq, beq_iff_eq, not_or] at hc
    apply loadF_zero
    intro k hk
    have h1 : ¬ (full * rate + 8 * i + k < data.size) := by omega
    have h2 : ¬ (full * rate + 8 * i + k = data.size) := by omega
    have h3 : ¬ (full * rate + 8 * i + k = (full + 1) * rate - 1) := by omega
    simp [Fast.padByte, h1, h2, h3]

theorem absorbAll_eq (rate : Nat) (hr : rate = 72 ∨ rate = 136 ∨ rate = 168) (data : ByteArray) :
    ∀ (n blk : Nat) (s : Quick.St), (blk + n) * rate ≤ data.size →
    (Quick.absorbAll rate data n blk s).toFast =
      (List.range' blk n).foldl (fun st b => Fast.keccakF (Fast.absorb st (data.get! ·) (b * rate) (rate / 8))) s.toFast := by
  intro n
  induction n with
  | zero => intro blk s _; rfl
  | succ n ih =>
    intro blk s hle
    have e1 : (blk + (n + 1)) * rate = blk * rate + n * rate + rate := by rw [Nat.add_mul, Nat.succ_mul] <;> omega
    have e2 : (blk + 1 + n) * rate = blk * rate + rate + n * rate := by rw [Nat.add_mul, Nat.add_mul, Nat.one_mul] <;> omega
    unfold Quick.absorbAll
    rw [ih (blk + 1) _ (by omega), List.range'_succ, List.foldl_cons]
    congr 1
    apply absorbF_eq
    intro i hi
    have hc : (i ≤ 25 || i + 1 == rate / 8) = true := by
      simp only [Bool.or_eq_true, decide_eq_true_eq, beq_iff_eq]; omega
    rw [if_pos hc]
    exact ld_eq _ _ (by omega)

theorem ite_yield {β : Type} (c : Prop) [Decidable c] (x y : β) :
    (if c then (pure (ForInStep.yield x) : Id (ForInStep β)) else pure (ForInStep.yield y)) = pure (ForInStep.yield (if c then x else y)) := by
  split <;> rfl

theorem fast_unfold (rate : Nat) (suffix : UInt8) (data : ByteArray) (n : Nat) (_hpos : 0 < rate) :
    Fast.sponge rate suffix data n =
      ((List.range' 0 ((n + rate - 1) / rate)).foldl (stepF rate n)
        (Fast.keccakF (Fast.absorb ((List.range' 0 (data.size / rate)).foldl
          (fun st blk => Fast.keccakF (Fast.absorb st (data.get! ·) (blk * rate) (rate / 8))) Fast.zero)
          (Fast.padByte data suffix ((data.size / rate + 1) * rate)) (data.size / rate * rate) (rate / 8)), ByteArray.empty)).2 := by
  unfold Fast.sponge
  simp only [Id.run, Std.Legacy.Range.forIn_eq_forIn_range', Std.Legacy.Range.size, Nat.sub_zero, Nat.add_sub_cancel, Nat.div_one,
    pure_bind, ite_yield, List.forIn_pure_yield_eq_foldl, List.range_eq_range']
  simp only [sqF_block]
  rfl

theorem sponge_eq (rate : Nat) (hr : rate = 72 ∨ rate = 136 ∨ rate = 168) (suffix : UInt8) (data : ByteArray) (n : Nat) :
    Quick.sponge rate suffix data n = Fast.sponge rate suffix data n := by
  have hpos : 0 < rate := by omega
  have h168 : rate ≤ 168 := by omega
  have h1 : data.size / rate * rate ≤ data.size := Nat.div_mul_le_self ..
  have h2 : data.size < (data.size / rate + 1) * rate := by
    have := Nat.lt_div_mul_add (a := data.size) hpos
    rw [Nat.succ_mul]; omega
  have hrem : data.size - data.size / rate * rate < rate := by rw [Nat.succ_mul] at h2; omega
  have key : (Quick.absorbF (Quick.absorbAll rate data (data.size / rate) 0 Quick.flipped)
        (tailB suffix data rate (data.size / rate) (data.size - data.size / rate * rate)) 0 (rate / 8)
        ((data.size - data.size / rate * rate) / 8)).toFast =
      Fast.keccakF (Fast.absorb ((List.range' 0 (data.size / rate)).foldl
          (fun st blk => Fast.keccakF (Fast.absorb st (data.get! ·) (blk * rate) (rate / 8))) Fast.zero)
          (Fast.padByte data suffix ((data.size / rate + 1) * rate)) (data.size / rate * rate) (rate / 8)) := by
    rw [absorbF_eq _ _ (Fast.padByte data suffix ((data.size / rate + 1) * rate)) 0 (data.size / rate * rate) (rate / 8)
      ((data.size - data.size / rate * rate) / 8)
      (fun i hi => tail_ok suffix data rate (data.size / rate) (data.size - data.size / rate * rate) hr (Nat.add_sub_cancel' h1) hrem i hi)]
    rw [absorbAll_eq rate hr data (data.size / rate) 0 Quick.flipped (by rw [Nat.zero_add]; exact h1), flipped_eq]
  rw [fast_unfold rate suffix data n hpos, foldF_all]
  unfold Quick.sponge
  dsimp only
  rw [go_eq rate hpos h168 n (n / rate + 1) _ ByteArray.empty n (by simp [ByteArray.size]) (by
    rcases hr with h | h | h <;> subst h <;> omega)]
  exact congrArg (fun x => emitLoop rate n ((n + rate - 1) / rate) x ByteArray.empty) key

end QEq

theorem Quick.keccakF_eq (s : Quick.St) : (Quick.keccakF s).toFast = Fast.keccakF s.toFast := QEq.keccakF_eq' s

theorem sha3_256Quick_eq (d : ByteArray) : sha3_256Quick d = sha3_256Fast d := QEq.sponge_eq 136 (by omega) _ d 32
theorem sha3_512Quick_eq (d : ByteArray) : sha3_512Quick d = sha3_512Fast d := QEq.sponge_eq 72 (by omega) _ d 64
theorem shake128Quick_eq (d : ByteArray) (n : Nat) : shake128Quick d n = shake128Fast d n := QEq.sponge_eq 168 (by omega) _ d n
theorem shake256Quick_eq (d : ByteArray) (n : Nat) : shake256Quick d n = shake256Fast d n := QEq.sponge_eq 136 (by omega) _ d n

end BlindLedger.Semantic
