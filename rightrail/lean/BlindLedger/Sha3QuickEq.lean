def permS (n : Nat) (s : Quick.St) : Quick.St :=
  Quick.perm n s.a0 s.a1 s.a2 s.a3 s.a4 s.a5 s.a6 s.a7 s.a8 s.a9 s.a10 s.a11 s.a12 s.a13 s.a14 s.a15 s.a16 s.a17 s.a18 s.a19 s.a20 s.a21 s.a22 s.a23 s.a24

def q2 (n : Nat) (s : Quick.St) : Quick.St :=
  qround (qround s (Quick.rcs[2*(12-(n+1))+0]!)) (Quick.rcs[2*(12-(n+1))+1]!)

theorem permS_succ (n : Nat) (s : Quick.St) : permS (n+1) s = permS n (q2 n s) := by
  unfold permS
  rfl

def fastFrom : Nat → Nat → Fast.St → Fast.St
  | _, 0, s => s
  | k, m+1, s => fastFrom (k+1) m (Fast.round s (Fast.roundConstants[k]!))

theorem rcs_eq : Quick.rcs = Fast.roundConstants := rfl

theorem permS_eq (n : Nat) (hn : n ≤ 12) (s : Quick.St) :
    (permS n s).toFast = fastFrom (24 - 2*n) (2*n) s.toFast := by
  induction n generalizing s with
  | zero => rfl
  | succ n ih =>
    rw [permS_succ, ih (by omega)]
    have e1 : 24 - 2*n = (24 - 2*(n+1)) + 2 := by omega
    have e2 : 2*(n+1) = 2*n + 2 := by omega
    have e3 : 2*(12-(n+1)) = 24 - 2*(n+1) := by omega
    rw [e1, e2]
    simp only [q2, qround_eq, rcs_eq, e3]
    rfl

theorem foldl_fastFrom (m k : Nat) (s : Fast.St) :
    (List.range' k m).foldl (fun st r => Fast.round st (Fast.roundConstants[r]!)) s = fastFrom k m s := by
  induction m generalizing k s with
  | zero => rfl
  | succ m ih => rw [List.range'_succ, List.foldl_cons, ih]; rfl

theorem keccakF_fast (s : Fast.St) : Fast.keccakF s = fastFrom 0 24 s := by
  unfold Fast.keccakF
  simp only [Id.run, Std.Legacy.Range.forIn_eq_forIn_range', Std.Legacy.Range.size, Nat.sub_zero, Nat.add_sub_cancel, Nat.div_one,
    bind_pure, List.forIn_pure_yield_eq_foldl, List.range_eq_range']
  exact foldl_fastFrom 24 0 s

theorem keccakF_eq' (s : Quick.St) : (Quick.keccakF s).toFast = Fast.keccakF s.toFast := by
  rw [keccakF_fast]
  exact permS_eq 12 (by omega) s

def gb (s : Fast.St) (a : Nat) : UInt8 := (Fast.lane s (a / 8) >>> UInt64.ofNat (8 * (a % 8))).toUInt8
def bytesOf (s : Fast.St) (k : Nat) : ByteArray := ⟨((List.range' 0 k).map (gb s)).toArray⟩

theorem bytesOf_size (s : Fast.St) (k : Nat) : (bytesOf s k).size = k := by simp [bytesOf, ByteArray.size]

theorem bytesOf_get (s : Fast.St) (k j : Nat) (h : j < k) : (bytesOf s k)[j]! = gb s j := by
  have h1 : j < (bytesOf s k).size := by rw [bytesOf_size]; exact h
  rw [getElem!_pos _ j h1, ByteArray.getElem_eq_getElem_data]
  simp [bytesOf]

def Good (k : Nat) (G : Nat → UInt8) (r : ByteArray) : Prop := r.size = k ∧ ∀ j, j < k → r[j]! = G j

theorem Good.eq_bytesOf {s : Fast.St} {k : Nat} {r : ByteArray} (h : Good k (gb s) r) : r = bytesOf s k := by
  obtain ⟨h1, h2⟩ := h
  have hs : r.size = (bytesOf s k).size := by rw [h1, bytesOf_size]
  apply ByteArray.ext
  apply Array.ext
  · exact hs
  · intro i hi1 hi2
    have hk : i < k := by have : i < r.size := hi1; omega
    have e1 := h2 i hk
    have e2 := bytesOf_get s k i hk
    rw [getElem!_pos _ i (by exact hi1), ByteArray.getElem_eq_getElem_data] at e1
    rw [getElem!_pos _ i (by show i < (bytesOf s k).size; exact hi2), ByteArray.getElem_eq_getElem_data] at e2
    rw [e1, e2]

