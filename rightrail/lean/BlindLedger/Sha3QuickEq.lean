theorem stage_mid (k o : Nat) (v : UInt64) (G : Nat → UInt8) (hG : ∀ t, t < 8 → G (o + t) = (v >>> UInt64.ofNat (8 * t)).toUInt8)
    (out : ByteArray) (hsz : out.size = k) (hpre : ∀ j, j < o → out[j]! = G j) (ho : o ≤ k) (REST : ByteArray → ByteArray)
    (hrest : ∀ out', out'.size = k → o + 8 ≤ k → (∀ j, j < o + 8 → out'[j]! = G j) → Good k G (REST out')) :
    Good k G (if k = o then out else if k < o + 8 then (if k = o then out else Quick.setLane out o v (k - o)) else REST (Quick.set8 out o v)) := by
  by_cases h1 : k = o
  · subst h1
    simp only [if_true]
    exact ⟨hsz, fun j hj => hpre j hj⟩
  · rw [if_neg h1]
    by_cases h2 : k < o + 8
    · rw [if_pos h2, if_neg h1]
      refine ⟨by rw [setLane_size]; exact hsz, fun j hj => ?_⟩
      rw [setLane_get out o v (k - o) (by omega) (by omega) (by omega)]
      by_cases h3 : o ≤ j ∧ j < o + (k - o)
      · rw [if_pos h3]
        have := hG (j - o) (by omega)
        rw [show o + (j - o) = j by omega] at this
        exact this.symm
      · rw [if_neg h3]
        exact hpre j (by omega)
    · rw [if_neg h2]
      apply hrest
      · rw [set8_size]; exact hsz
      · omega
      · intro j hj
        rw [set8_get out o v (by omega) j]
        by_cases h3 : o ≤ j ∧ j < o + 8
        · rw [if_pos h3]
          have := hG (j - o) (by omega)
          rw [show o + (j - o) = j by omega] at this
          exact this.symm
        · rw [if_neg h3]
          exact hpre j (by omega)

theorem stage_first (k o : Nat) (v : UInt64) (G : Nat → UInt8) (hG : ∀ t, t < 8 → G (o + t) = (v >>> UInt64.ofNat (8 * t)).toUInt8)
    (out : ByteArray) (hsz : out.size = k) (hpre : ∀ j, j < o → out[j]! = G j) (ho : o ≤ k) (REST : ByteArray → ByteArray)
    (hrest : ∀ out', out'.size = k → o + 8 ≤ k → (∀ j, j < o + 8 → out'[j]! = G j) → Good k G (REST out')) :
    Good k G (if k < o + 8 then (if k = o then out else Quick.setLane out o v (k - o)) else REST (Quick.set8 out o v)) := by
  have := stage_mid k o v G hG out hsz hpre ho REST hrest
  by_cases h1 : k = o
  · subst h1; simpa using this
  · rw [if_neg h1] at this; exact this

theorem stage_last (k o : Nat) (v : UInt64) (G : Nat → UInt8) (hG : ∀ t, t < 8 → G (o + t) = (v >>> UInt64.ofNat (8 * t)).toUInt8)
    (out : ByteArray) (hsz : out.size = k) (hpre : ∀ j, j < o → out[j]! = G j) (ho : o ≤ k) (hk : k ≤ o + 8) :
    Good k G (if k = o then out else if k < o + 8 then Quick.setLane out o v (k - o) else Quick.set8 out o v) := by
  have := stage_mid k o v G hG out hsz hpre ho id (fun out' hs _ he => ⟨hs, fun j hj => he j (by omega)⟩)
  by_cases h1 : k = o
  · subst h1; simpa using this
  · rw [if_neg h1] at this
    by_cases h2 : k < o + 8
    · rw [if_pos h2, if_neg h1] at this; rw [if_neg h1, if_pos h2]; exact this
    · rw [if_neg h2] at this; rw [if_neg h1, if_neg h2]; exact this

theorem gb_lane (s : Fast.St) (i t : Nat) (ht : t < 8) :
    gb s (8 * i + t) = (Fast.lane s i >>> UInt64.ofNat (8 * t)).toUInt8 := by
  unfold gb
  rw [show (8 * i + t) / 8 = i by omega, show (8 * i + t) % 8 = t by omega]
