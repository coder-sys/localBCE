import BlindLedger.Sha3Fast
import BlindLedger.Sha3Quick

/-! `Sha3Quick` equals `Sha3Fast` (and so FIPS 202 through `Sha3FastEq.lean`).  The permutation is compared round by round:
    a stored (complemented) state is the true state xor `maskM`, one stored round equals one true round (`qround_eq`), and
    a two-round loop step is two true rounds.  The sponge is compared lane load by lane load and byte by byte. -/
namespace BlindLedger.Semantic


def Quick.St.toFast (s : Quick.St) : Fast.St :=
  ⟨s.a0, s.a1 ^^^ Quick.ones, s.a2 ^^^ Quick.ones, s.a3, s.a4, s.a5, s.a6, s.a7, s.a8 ^^^ Quick.ones, s.a9, s.a10, s.a11,
   s.a12 ^^^ Quick.ones, s.a13, s.a14, s.a15, s.a16, s.a17 ^^^ Quick.ones, s.a18, s.a19, s.a20 ^^^ Quick.ones, s.a21, s.a22, s.a23, s.a24⟩

