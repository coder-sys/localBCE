theorem ones_bv : ones.toBitVec = BitVec.allOnes 64 := by decide

local macro "qbits" : tactic => `(tactic| first | exact True.intro | (
  apply UInt64.eq_of_toBitVec_eq
  apply BitVec.eq_of_getLsbD_eq
  intro i hi
  simp only [UInt64.toBitVec_xor, UInt64.toBitVec_and, UInt64.toBitVec_or, UInt64.toBitVec_not, BitVec.getLsbD_xor,
    BitVec.getLsbD_and, BitVec.getLsbD_or, BitVec.getLsbD_not, hi, decide_true, Bool.true_and, ones_bv, BitVec.getLsbD_allOnes]
  grind))

theorem rl_bit (x n : UInt64) (hn : n.toNat < 64) (i : Nat) (hi : i < 64) :
    (Fast.rl x n).toBitVec.getLsbD i = ((decide (n.toNat ≤ i) && x.toBitVec.getLsbD (i - n.toNat)) ||
      x.toBitVec.getLsbD ((64 - n.toNat) % 64 + i)) := by
  have h1 := n.toNat_lt_size
  have e : (18446744073709551616 - n.toNat) % 64 = (64 - n.toNat) % 64 := by
    simp only [UInt64.size] at h1; omega
  simp [Fast.rl, UInt64.toBitVec_sub, hi, e, Nat.mod_eq_of_lt hn]
  by_cases h : n.toNat ≤ i
  · have : ¬ i < n.toNat := by omega
    simp [h, this, BitVec.getLsbD_eq_getElem (by omega : i - n.toNat < 64)]
  · have : i < n.toNat := by omega
    simp [h, this]

theorem rl_xor (x y n : UInt64) (hn : n.toNat < 64) : Fast.rl (x ^^^ y) n = Fast.rl x n ^^^ Fast.rl y n := by
  apply UInt64.eq_of_toBitVec_eq
  apply BitVec.eq_of_getLsbD_eq
  intro i hi
  simp only [rl_bit _ _ hn _ hi, UInt64.toBitVec_xor, BitVec.getLsbD_xor]
  by_cases h0 : n.toNat = 0
  · simp [h0]
  · have e : (64 - n.toNat) % 64 = 64 - n.toNat := by omega
    by_cases hlt : i < n.toNat
    · have : ¬ n.toNat ≤ i := by omega
      simp [this, e]
    · have : n.toNat ≤ i := by omega
      have g : ∀ z : BitVec 64, z.getLsbD (64 - n.toNat + i) = false := fun z => BitVec.getLsbD_of_ge _ _ (by omega)
      simp [this, e, g]

theorem rl_ones (n : UInt64) (hn : n.toNat < 64) : Fast.rl ones n = ones := by
  apply UInt64.eq_of_toBitVec_eq
  apply BitVec.eq_of_getLsbD_eq
  intro i hi
  simp only [rl_bit _ _ hn _ hi, ones_bv, BitVec.getLsbD_allOnes]
  by_cases h : n.toNat ≤ i
  · simp [h, hi]; omega
  · simp [h, hi]; omega

