{
  "_note": "Scenario set for the shadow run (scripts/rightrail_shadow.py; design docs/integration/SHADOW_RUN_DESIGN.md). Hand-written synthetic claims and feed rows: invented ids, no PHI, not legally verified. Expected outcomes are stated here before any run. On a matched scenario the claim's flags and the feed rows say the same thing, so agreement there is by construction. Claim dates are day counts since 1970-01-01; feed dates are calendar days. claim_amount is whole dollars, charge_cents is cents.",
  "synthetic": true,
  "secret": "synthetic-shadow-tenant-secret-0001",
  "today": "2027-03-15",
  "feeds": {
    "fresh": {
      "dmf": {"as_of": "2027-03-10", "rows": [{"member_id": "SH-M-DEAD", "date": "2027-02-01"}]},
      "pdeath": {"as_of": "2027-03-01", "rows": [{"npi": "1500000017", "date": "2027-02-01"}]},
      "excl": {"as_of": "2027-03-10", "rows": [{"npi": "1500000009", "from": "2020-01-01", "to": "9999-12-31"}]},
      "span": {"as_of": "2027-03-14", "rows": [
        {"member_id": "SH-M-CLEAN-1", "plan": "PLAN-A", "from": "2027-01-01", "to": "2027-12-31"},
        {"member_id": "SH-M-CLEAN-2", "plan": "PLAN-A", "from": "2027-01-01", "to": "2027-12-31"},
        {"member_id": "SH-M-DEAD", "plan": "PLAN-A", "from": "2027-01-01", "to": "2027-12-31"},
        {"member_id": "SH-M-EXCL", "plan": "PLAN-A", "from": "2027-01-01", "to": "2027-12-31"},
        {"member_id": "SH-M-PDEAD", "plan": "PLAN-A", "from": "2027-01-01", "to": "2027-12-31"},
        {"member_id": "SH-M-LAPSED", "plan": "PLAN-A", "from": "2026-01-01", "to": "2026-12-31"},
        {"member_id": "SH-M-REPEAT", "plan": "PLAN-A", "from": "2027-01-01", "to": "2027-12-31"},
        {"member_id": "SH-M-FUTURE", "plan": "PLAN-A", "from": "2027-01-01", "to": "2027-12-31"},
        {"member_id": "SH-M-STALE", "plan": "PLAN-A", "from": "2027-01-01", "to": "2027-12-31"},
        {"member_id": "SH-M-MISMATCH", "plan": "PLAN-A", "from": "2027-01-01", "to": "2027-12-31"},
        {"member_id": "SH-M-BADNPI", "plan": "PLAN-A", "from": "2027-01-01", "to": "2027-12-31"}
      ]}
    },
    "stale_deaths": {
      "like": "fresh",
      "dmf": {"as_of": "2026-12-01", "rows": [{"member_id": "SH-M-DEAD", "date": "2026-11-01"}]}
    }
  },
  "base_claim": {
    "claim_amount": 125,
    "provider_npi": "1234567893",
    "diagnosis_count": 1,
    "diagnosis_codes": ["Z00.00"],
    "service_lines": [{"procedure_code": "99213", "charge_cents": 12500, "units": 1}],
    "eligibility_active": 1,
    "aid_code": 53,
    "benefit_level_exists": 1,
    "date_of_service_from": 20882,
    "eligibility_period_from": 20819,
    "eligibility_period_thru": 21183,
    "soc_amount": 0,
    "soc_met": 1,
    "provider_enrolled": 1,
    "provider_type_valid": 1,
    "billing_code_valid": 1,
    "units_valid": 1,
    "is_duplicate": 0,
    "disability_determination_valid": 1,
    "recipient_not_deceased": 1,
    "physician_certification_valid": 1
  },
  "steps": [
    {"name": "first_batch", "feeds": "fresh", "store": "main",
     "scenarios": ["clean_one_line", "clean_two_lines", "member_deceased", "provider_excluded", "provider_deceased",
                   "enrollment_lapsed", "member_absent_from_feed", "repeat_first_claim", "service_date_in_the_future",
                   "claim_total_mismatch", "bad_billing_npi"]},
    {"name": "second_batch", "feeds": "fresh", "store": "main", "scenarios": ["repeat_of_a_paid_claim"]},
    {"name": "stale_feed", "feeds": "stale_deaths", "store": "separate", "scenarios": ["stale_death_feed"]}
  ],
  "scenarios": [
    {"name": "clean_one_line", "kind": "matched",
     "claim": {"claim_id": "SH-CLAIM-001", "member_id": "SH-M-CLEAN-1"},
     "expect": {"local": ["APPROVED", null], "rightrail": {"outcome": "ALLOW", "reasons": []}, "category": "agree_allow"},
     "why": "Enrolled member, clean provider, fresh feeds."},
    {"name": "clean_two_lines", "kind": "matched",
     "claim": {"claim_id": "SH-CLAIM-002", "member_id": "SH-M-CLEAN-2",
               "service_lines": [{"procedure_code": "99213", "charge_cents": 10000, "units": 1}, {"procedure_code": "36415", "charge_cents": 2500, "units": 1}]},
     "expect": {"local": ["APPROVED", null], "rightrail": {"outcome": "ALLOW", "reasons": []}, "category": "agree_allow"},
     "why": "Two lines that add up to the claim total; both allowed."},
    {"name": "member_deceased", "kind": "matched",
     "claim": {"claim_id": "SH-CLAIM-003", "member_id": "SH-M-DEAD", "recipient_not_deceased": 0},
     "expect": {"local": ["DENIED", "G9_RECIPIENT_DECEASED"], "rightrail": {"outcome": "HOLD", "reasons": ["MEMBER_DECEASED"]}, "category": "agree_hold"},
     "why": "The death feed dates the member's death before the service."},
    {"name": "provider_excluded", "kind": "matched",
     "claim": {"claim_id": "SH-CLAIM-004", "member_id": "SH-M-EXCL", "provider_npi": "1500000009", "provider_enrolled": 0},
     "expect": {"local": ["DENIED", "G5_PROVIDER_NOT_ENROLLED"], "rightrail": {"outcome": "HOLD", "reasons": ["PROVIDER_EXCLUDED"]}, "category": "agree_hold"},
     "why": "The billing provider is on the exclusion feed on the service date."},
    {"name": "provider_deceased", "kind": "matched",
     "claim": {"claim_id": "SH-CLAIM-005", "member_id": "SH-M-PDEAD", "provider_npi": "1500000017", "provider_enrolled": 0},
     "expect": {"local": ["DENIED", "G5_PROVIDER_NOT_ENROLLED"], "rightrail": {"outcome": "HOLD", "reasons": ["PROVIDER_DECEASED"]}, "category": "agree_hold"},
     "why": "The provider-death feed dates the billing provider's death before the service."},
    {"name": "enrollment_lapsed", "kind": "matched",
     "claim": {"claim_id": "SH-CLAIM-006", "member_id": "SH-M-LAPSED", "eligibility_period_from": 20454, "eligibility_period_thru": 20818},
     "expect": {"local": ["DENIED", "G3_MONTH_OF_SERVICE_FAILED"], "rightrail": {"outcome": "HOLD", "reasons": ["MEMBER_NOT_ENROLLED"]}, "category": "agree_hold"},
     "why": "The member's only span ended before the service date."},
    {"name": "member_absent_from_feed", "kind": "differ",
     "claim": {"claim_id": "SH-CLAIM-007", "member_id": "SH-M-ABSENT"},
     "disagrees_on": ["eligibility_active", "eligibility_period_from", "eligibility_period_thru"],
     "expect": {"local": ["APPROVED", null], "rightrail": {"outcome": "HOLD", "reasons": ["MEMBER_NOT_ENROLLED"]}, "category": "lean_holds_on_mapped_rule_local_approves"},
     "why": "Expected to differ. The claim's flags say the member is eligible; the enrollment feed has no span for the member. RightRail decides from its feed."},
    {"name": "repeat_first_claim", "kind": "matched",
     "claim": {"claim_id": "SH-CLAIM-008", "member_id": "SH-M-REPEAT"},
     "expect": {"local": ["APPROVED", null], "rightrail": {"outcome": "ALLOW", "reasons": []}, "category": "agree_allow"},
     "why": "The claim the next batch repeats. Allowed and sealed in the first batch."},
    {"name": "repeat_of_a_paid_claim", "kind": "differ",
     "claim": {"claim_id": "SH-CLAIM-009", "member_id": "SH-M-REPEAT"},
     "disagrees_on": [],
     "expect": {"local": ["APPROVED", null], "rightrail": {"outcome": "ANSWERED", "reasons": ["FFS_DUPLICATE_LINE"]}, "category": "rightrail_answered_local_approves"},
     "why": "Expected to differ. A new claim id that repeats the paid claim's member, provider, date, procedure, units and charge. RightRail remembers what it released and answers the repeat without paying it; localBCE keeps no history, and its is_duplicate flag is 0 because nothing told it."},
    {"name": "service_date_in_the_future", "kind": "differ",
     "claim": {"claim_id": "SH-CLAIM-010", "member_id": "SH-M-FUTURE", "date_of_service_from": 20909},
     "disagrees_on": [],
     "expect": {"local": ["APPROVED", null], "rightrail": {"outcome": "HUMAN_REVIEW", "reasons": ["SERVICE_DATE_FUTURE"]}, "category": "lean_review_local_approves"},
     "why": "Expected to differ. The service date (2027-04-01) is after the batch date. RightRail sends it to a person; localBCE has no rule on today's date."},
    {"name": "stale_death_feed", "kind": "differ",
     "claim": {"claim_id": "SH-CLAIM-011", "member_id": "SH-M-STALE"},
     "disagrees_on": [],
     "expect": {"local": ["APPROVED", null], "rightrail": {"outcome": "HUMAN_REVIEW", "reasons": ["STALE_DMF"]}, "category": "lean_review_local_approves"},
     "why": "Expected to differ. The death feed is 104 days old (limit 90), so RightRail does not read it as 'nobody died' and sends the line to a person; localBCE has no freshness test."},
    {"name": "claim_total_mismatch", "kind": "not_sent",
     "claim": {"claim_id": "SH-CLAIM-012", "member_id": "SH-M-MISMATCH", "claim_amount": 126},
     "disagrees_on": [],
     "expect": {"local": ["APPROVED", null], "rightrail": {"set_aside": "total_mismatch"}, "category": "not_sent_local_approves"},
     "why": "claim_amount (126 dollars) is not the line sum (12500 cents). The adapter sets it aside; the Rust engine does not check the total."},
    {"name": "bad_billing_npi", "kind": "not_sent",
     "claim": {"claim_id": "SH-CLAIM-013", "member_id": "SH-M-BADNPI", "provider_npi": "1234567890"},
     "disagrees_on": [],
     "expect": {"local": ["APPROVED", null], "rightrail": {"set_aside": "bad_npi"}, "category": "not_sent_local_approves"},
     "why": "The billing NPI fails its check digit. The adapter sets it aside; the Rust engine does not check the NPI."}
  ]
}
